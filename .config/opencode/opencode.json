{
  "mcp": {
    "servers": {
      "fastmail": {
        "type": "remote",
        "url": "https://api.fastmail.com/mcp"
      },
      "rememberthemilk": {
        "type": "remote",
        "url": "https://www.rememberthemilk.com/mcp"
      },
      "remctl": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "exec \"$HOME/bin/remctl\" mcp"
        ]
      },
      "grim": {
        "type": "remote",
        "url": "https://grimnotes.app/mcp"
      }
    }
  }
}